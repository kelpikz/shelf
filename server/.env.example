# Copy this file to .env and fill in the values. .env is not in git.

# Only a GitHub account with this email, marked verified, can log in.
OWNER_EMAIL=you@example.com

# The number of the same GitHub account. Find it at
# https://api.github.com/users/<your-login> in the "id" field.
OWNER_GITHUB_ID=

# From your GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps).
# Callback URL in the app: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The address of the admin host. No trailing slash.
ADMIN_URL=http://localhost:8080

# Optional.
# DATA_DIR=data
# PORT=8080
