# From the repo root, copy server/env.prod.example to .env for Docker deployment.
# Replace these example values before you start shelf. .env is not in git.
OWNER_EMAIL=owner@example.com
OWNER_GITHUB_ID=123456
GITHUB_CLIENT_ID=replace-with-your-client-id
GITHUB_CLIENT_SECRET=replace-with-your-client-secret
ADMIN_URL=https://files-admin.ajitha.fyi
FILES_URL=https://files.ajitha.fyi

# Byte counts. These defaults each equal 1 GiB.
UPLOAD_MIN_FREE_BYTES=1073741824
SITE_STORAGE_MAX_BYTES=1073741824
