# From the repo root, copy server/env.local.example to server/.env.
# Fill in the values. Keep an existing server/.env if it is already configured.
# .env files are not in git.

# Only a GitHub account with this email, marked verified, can log in.
OWNER_EMAIL=you@example.com

# The number of the same GitHub account. Find it at
# https://api.github.com/users/<your-login> in the "id" field.
OWNER_GITHUB_ID=

# From your GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps).
# Callback URL in the app: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The address of the admin host. No trailing slash.
ADMIN_URL=http://localhost:8080

# The address of the Sites host. It must have a different host name from
# ADMIN_URL. Browsers send *.localhost to your own computer.
FILES_URL=http://files.localhost:8080

# Optional.
# DATA_DIR=data
# PORT=8080

# Free disk bytes to leave after allowing for a full upload. Default: 1 GiB.
# UPLOAD_MIN_FREE_BYTES=1073741824

# Total Site file bytes, including old and staged folders. 0 means no quota.
# Set a budget before deploy. Replacements need room for both copies.
# SITE_STORAGE_MAX_BYTES=0
